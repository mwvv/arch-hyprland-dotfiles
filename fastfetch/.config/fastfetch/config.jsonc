{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "blackarch",
    "color": { "1": "white", "2": "white", "3": "white" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "",
    "color": { "keys": "bright_white", "title": "bright_white" }
  },
  "modules": [
    "break",
    "break",
    "break",
    { "type": "title",    "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    "break",
    { "type": "os",       "key": "os          ", "format": "{name} {arch}" },
    { "type": "host",     "key": "host        ", "format": "{version}" },
    { "type": "kernel",   "key": "kernel      ", "format": "{release}" },
    { "type": "wm",       "key": "wm          ", "format": "{pretty-name}" },
    { "type": "packages", "key": "packages    " },
    { "type": "uptime",   "key": "uptime      " },
    "break",
    { "type": "cpu",      "key": "cpu         ", "format": "i5-13420H · {cores-physical} cores / {cores-logical} threads" },
    { "type": "gpu",      "key": "gpu         ", "format": "{name}" },
    { "type": "memory",   "key": "memory      " },
    { "type": "disk",     "key": "disk        ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "battery     ", "format": "{capacity} {status}" },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
