/* Lanzador de apps / portapapeles — glass, centrado */
@import "~/.config/rofi/colors.rasi"

* {
    font:             "Inter 12";
    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @bordercol;
    border-radius:    14px;
}

mainbox {
    padding:  14px;
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          10px 14px;
    background-color: @surface;
    border-radius:    9px;
    spacing:          12px;
    children:         [ prompt, entry ];
}
prompt { text-color: @fg; font: "Inter SemiBold 12"; }
entry  { placeholder: "Buscar…"; placeholder-color: @dim; cursor: text; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      3px;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 8px;
}
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
element selected.normal {
    background-color: @accent;
    text-color:       @onaccent;
}
element-text selected, element-icon selected { text-color: inherit; }
