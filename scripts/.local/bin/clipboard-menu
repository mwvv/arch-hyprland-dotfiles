#!/usr/bin/env bash
# Historial del portapapeles (cliphist + rofi)
pgrep -x rofi >/dev/null && { pkill -x rofi; exit 0; }
sel=$(cliphist list | rofi -dmenu -i -display-columns 2 -p "Portapapeles" \
        -theme ~/.config/rofi/launcher.rasi -theme-str 'entry { placeholder: "Buscar en el historial…"; } element-icon { enabled: false; }')
[[ -n $sel ]] && cliphist decode <<<"$sel" | wl-copy
