def sub(path, pattern, repl, count=1):
    s = path.read_text()
    new, n = re.subn(pattern, repl, s, count=count, flags=re.M)
    if n == 0:
        sys.exit(f"no encontré {pattern!r} en {path}")
    path.write_text(new)

def apply(t):
    # Hyprland: bordes
    sub(F["hypr"], r'active_border   = \{ colors = \{"rgba\([0-9a-f]+\)", "rgba\([0-9a-f]+\)"\}',
        f'active_border   = {{ colors = {{"rgba({t["border"][0]})", "rgba({t["border"][1]})"}}')
    sub(F["hypr"], r'inactive_border = "rgba\([0-9a-f]+\)"', f'inactive_border = "rgba({t["inactive"]})"')

    # Waybar: variables
    for k, v in t["css"].items():
        sub(F["css"], rf'^@define-color {k}( +).*;$', rf'@define-color {k}\g<1>{v};')
    sub(F["css"], r'^/\* Waybar — .*? \(', f'/* Waybar — {t["name"]} (')

    # Rofi: variables
    for k, v in t["rasi"].items():
        sub(F["rasi"], rf'^    {k}:( +)#[0-9a-f]+;$', rf'    {k}:\g<1>{v};')
    sub(F["rasi"], r'^/\* Colores compartidos de rofi — .*? \*/', f'/* Colores compartidos de rofi — {t["name"]} */')

    # Mako
    m = t["mako"]
    F["mako"].write_text(f"""# Notificaciones — {t['name']}
font=JetBrainsMono Nerd Font 10
background-color={m['bg']}
text-color={m['fg']}
border-color={m['border']}
border-size=1
border-radius=12
padding=12
margin=10
width=350
default-timeout=5000
anchor=top-right

[urgency=low]
border-color={m['low']}

[urgency=critical]
border-color={m['crit']}
default-timeout=0
""")

    # Hyprlock
    l = t["lock"]
    sub(F["lock"], r'^# Pantalla de bloqueo — .*$', f'# Pantalla de bloqueo — {t["name"]}')
    sub(F["lock"], r'(text = \$TIME\n    color = rgba\()[0-9a-f]+', rf'\g<1>{l["time"]}')
    sub(F["lock"], r'(date \+"%A, %d %B"\n    color = rgba\()[0-9a-f]+', rf'\g<1>{l["date"]}')
    for key in ("outer", "inner", "font", "check", "fail"):
        sub(F["lock"], rf'^(    {key}_color = rgba\()[0-9a-f]+', rf'\g<1>{l[key]}')
    sub(F["lock"], r'foreground="##[0-9a-f]+"', f'foreground="##{l["ph"]}"')

    # Kitty: bloque de colores desde "# Tema" hasta el final
    k = t["kitty"]; c = k["c"]
    names = ["negro", "rojo", "verde", "amarillo", "azul", "magenta", "cian", "blanco"]
    pal = "\n".join(f"# {n}\ncolor{i:<2} {c[i]}\ncolor{i+8:<2} {c[i+8]}" for i, n in enumerate(names))
    s = F["kitty"].read_text()
    s = s[:s.index("# Tema")] + f"""# Tema {t['name']}
foreground            {k['fg']}
background            {k['bg']}
selection_foreground  {k['selfg']}
selection_background  {k['selbg']}
cursor                {k['cursor']}
cursor_text_color     {k['bg']}
url_color             {k['url']}

{pal}
"""
    F["kitty"].write_text(s)

    # Fastfetch
    f = t["ff"]
    # (el logo de fastfetch mantiene su color propio: rojo SCP)
    sub(F["ff"], r'"color": \{ "keys": "[^"]*", "title": "[^"]*" \}',
        f'"color": {{ "keys": "{f["keys"]}", "title": "{f["keys"]}" }}')

def reload():
    for cmd in (["hyprctl", "reload"], ["killall", "-SIGUSR2", "waybar"], ["makoctl", "reload"]):
        subprocess.run(cmd, capture_output=True)
    pids = subprocess.run(["pgrep", "-x", "kitty"], capture_output=True, text=True).stdout.split()
    for p in pids:
        subprocess.run(["kill", "-SIGUSR1", p])

if __name__ == "__main__":
    name = sys.argv[1] if len(sys.argv) > 1 else ""
    if not name:
        labels = {T[k]["name"]: k for k in T}
        r = subprocess.run(["rofi", "-dmenu", "-i", "-no-custom", "-p", "Tema",
                            "-theme", str(Path.home() / ".config/rofi/launcher.rasi"),
                            "-theme-str", "listview { lines: 3; } entry { placeholder: \"\"; }"],
                           input="\n".join(labels), capture_output=True, text=True)
        name = labels.get(r.stdout.strip(), "")
        if not name:
            sys.exit(0)
    if name not in T:
        sys.exit(f"uso: theme.py [{' | '.join(T)}]")
    apply(T[name]); reload()
    print(f"tema aplicado: {T[name]['name']}")
    subprocess.run(["notify-send", "-a", "Tema", "Tema aplicado", T[name]["name"]])
