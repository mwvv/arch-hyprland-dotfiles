from pathlib import Path

D = Path.home() / "dotfiles"
F = {
    "hypr":   D / "hypr/.config/hypr/hyprland.lua",
    "lock":   D / "hypr/.config/hypr/hyprlock.conf",
    "css":    D / "waybar/.config/waybar/style.css",
    "rasi":   D / "rofi/.config/rofi/colors.rasi",
    "mako":   D / "mako/.config/mako/config",
    "kitty":  D / "kitty/.config/kitty/kitty.conf",
    "ff":     D / "fastfetch/.config/fastfetch/config.jsonc",
}

T = {
 "neutro": dict(
   name="Glass neutro",
   border=("ffffff59", "ffffff1a"), inactive="ffffff12",
