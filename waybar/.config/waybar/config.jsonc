{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 20,
  "margin-right": 20,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/perfil",
    "cpu",
    "memory",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "^[^A-Za-z0-9]+ (.*)": "$1"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#e6e6e6'><b>{}</b></span>",
        "weekdays": "<span color='#6c6c6c'>{}</span>",
        "today": "<span color='#d22630'><b>{}</b></span>"
      }
    },
    "on-click-right": "hyprsunset-toggle"
  },
  "cpu": {
    "format": "󰻠  {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "󰍛  {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mute",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "tooltip-format": "{desc}",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "format-wifi": "{icon}  {signalStrength}%",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰤮  offline",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
    "max-length": 12,
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "kitty -e nmtui",
    "format-disabled": "󰀝  avión",
    "format-linked": "󰤮  sin IP",
    "tooltip-format-disabled": "Modo avión / Wi-Fi apagado · clic para encender",
    "tooltip-format-disconnected": "Sin conexión · clic para ver redes"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{timeTo}"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "custom/perfil": {
    "exec": "/home/mwvv/.local/bin/perfil-waybar",
    "return-type": "json",
    "interval": 1,
    "on-click": "/home/mwvv/.local/bin/ciclar-perfil"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Apagar, reiniciar, bloquear…",
    "on-click": "powermenu"
  }
}
